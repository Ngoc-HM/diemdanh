# Chép thành .env rồi điền giá trị thật. File .env không bao giờ được commit.

# Chuỗi kết nối PostgreSQL. Database chưa có thì `npm run db` tự tạo.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/company_mana"

# Khoá ký session (JWT). Production bắt buộc >= 32 ký tự, nếu không app sẽ
# dừng ngay khi khởi động. Sinh khoá mới:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=""

# Tài khoản quản trị đầu tiên. Chỉ dùng để khởi tạo lần đầu — sau khi bảng
# Admin đã có bản ghi thì đổi mật khẩu ở /admin/change-password.
# Admin đăng nhập ở /login cùng ô với nhân viên, bằng tên đăng nhập này (có thể
# là "admin" hoặc một email, miễn không trùng email nhân viên nào). Không có
# mật khẩu mặc định: thiếu AUTH_ADMIN_PASSWORD thì `npm run seed` dừng.
AUTH_ADMIN_USERNAME="admin"
AUTH_ADMIN_PASSWORD=""

# Nơi lưu logo và ảnh đại diện upload lên. Bỏ trống thì dùng storage/uploads.
# Chạy container thì gắn volume vào thư mục này.
# UPLOAD_DIR="/var/lib/cham-cong/uploads"

# ---- Chạy bằng Docker (docker-compose.yml) ----
# Mật khẩu Postgres trong container db. Bắt buộc khi chạy docker compose.
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
POSTGRES_PASSWORD=""

# Bật HTTPS bằng Caddy (xem Caddyfile). Bỏ trống nếu đã có reverse proxy khác.
# COMPOSE_PROFILES="proxy"
# Tên miền thật -> TLS_MODE là email để xin chứng chỉ Let's Encrypt.
# Chỉ có IP trong mạng riêng -> liệt kê IP, TLS_MODE=internal (chứng chỉ tự ký).
# SITE_ADDRESS="cham-cong.congty.vn"
# TLS_MODE="it@congty.vn"
# SITE_ADDRESS="https://100.116.216.43, https://192.168.1.28"
# TLS_MODE="internal"
# DEFAULT_SNI="100.116.216.43"
