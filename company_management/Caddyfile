# Reverse proxy HTTPS phía trước app (bật bằng COMPOSE_PROFILES=proxy trong .env).
#
# Hai lối vào, cùng một app:
#  - APP_DOMAIN (vd nv.jupiter-ai.pro): tên miền trỏ về IP nội bộ của server
#    (bản ghi DNS only, không proxy). Chứng chỉ Let's Encrypt xin qua DNS-01 của
#    Cloudflare (CLOUDFLARE_API_TOKEN, quyền Zone · DNS · Edit) nên không phải
#    mở cổng ra Internet; ngoài mạng công ty tra ra IP nội bộ cũng không vào
#    được. Trình duyệt tin chứng chỉ này: lưu được mật khẩu, giữ được phiên.
#  - SITE_ADDRESS (các IP LAN / Tailscale): chứng chỉ Caddy tự ký (TLS_MODE=
#    internal), trình duyệt cảnh báo — chỉ để dự phòng / quản trị.
{
	# Truy cập bằng IP thì trình duyệt không gửi SNI, Caddy dùng tên này để chọn
	# chứng chỉ.
	default_sni {$DEFAULT_SNI:localhost}
}

(app) {
	encode gzip
	# Upload ảnh tối đa 2MB, chừa khoảng cho phần bọc multipart.
	request_body {
		max_size 3MB
	}
	reverse_proxy app:3000
}

{$APP_DOMAIN:localhost.invalid} {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
	import app
}

{$SITE_ADDRESS:localhost} {
	tls {$TLS_MODE:internal}
	import app
}
